@dataclass(frozen=True)
class Snapshot:
    service: str
    strategy: str
    autostart: str
    versions: str
    profiles: tuple
    can_rollback: bool


def run(args):
    env = os.environ.copy()
    for key in tuple(env):
        if key.startswith(("ZF_", "_ZF_", "BASH_FUNC_")) or key in ("BASH_ENV", "ENV"):
            env.pop(key)
    env.update(PATH="/usr/bin:/usr/sbin:/bin", LC_ALL="C.UTF-8")
    return subprocess.run(
        args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, encoding="utf-8", errors="replace", env=env, check=False,
    )


def read_sonar(*args):
    result = run([SONAR, *args])
    if result.returncode:
        raise RuntimeError(result.stdout.strip() or "Ошибка чтения состояния Zapret.")
    return result.stdout.strip()


def profile_label(profile):
    if not profile:
        return ""
    custom = profile.startswith("custom:")
    name = profile.removeprefix("custom:")
    title = "General" if name == "general.bat" else name.removesuffix(".bat").removeprefix("general ").strip("()")
    return f"Custom · {title}" if custom else title


def read_snapshot():
    data = json.loads(read_sonar("status", "--json"))
    profiles = tuple(p for p in read_sonar("_list").splitlines() if p.endswith(".bat"))
    try:
        custom = tuple(f"custom:{p}" for p in (CUSTOM_ROOT / "valid.txt").read_text().splitlines() if p.endswith(".bat"))
    except FileNotFoundError:
        custom = ()
    strategy = data["strategy"]
    if strategy and CONFIG.is_file() and f"{CUSTOM_ROOT}/" in CONFIG.read_text(errors="replace"):
        strategy = f"custom:{strategy}"
    snapshots = json.loads(read_sonar("snapshots", "--json"))["snapshots"]
    version = data["zapret"] or "—"
    if version.startswith("github version ") and len(version.split()) >= 3:
        version = version.split()[2]
    versions = f"Flowseal {data['flowseal'] or '—'} · Zapret {version} · Sonar {data['sonar_version']}"
    if custom:
        versions += f"\nCustom {CUSTOM_VERSION} · {len(custom)} проф."
    return Snapshot(
        data["service_state"], strategy, read_sonar("_state", "autostart"),
        versions, profiles + custom, len(snapshots) > 1,
    )


