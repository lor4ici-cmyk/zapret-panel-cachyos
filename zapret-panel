    def open_rtc_report(self, _button):
        dialog = Gtk.FileChooserDialog(
            title="Отчёт демки Discord", transient_for=self, action=Gtk.FileChooserAction.OPEN,
        )
        dialog.add_button("Отмена", Gtk.ResponseType.CANCEL)
        dialog.add_button("Открыть", Gtk.ResponseType.ACCEPT)
        hint = label("Открой chrome://webrtc-internals перед просмотром демки в веб-Discord. "
                     "Выключи камеры, оставь открытой только нужную трансляцию на 10–15 секунд "
                     "и скачай обычный dump WebRTC Internals. Файл читается локально.", "muted")
        hint.set_line_wrap(True)
        hint.show()
        dialog.set_extra_widget(hint)
        response = dialog.run()
        path = dialog.get_filename()
        dialog.destroy()
        if response == Gtk.ResponseType.ACCEPT and path:
            try:
                result = discord_rtc_report(Path(path))
            except (ValueError, OSError, EOFError) as exc:
                result = f"Отчёт не удалось прочитать. {exc}"
            self.detail.get_buffer().set_text(f"Результат сессии Discord\n\n{result}")

    def show_result(self, selection):
        model, row = selection.get_selected()
        self.detail.get_buffer().set_text(model[row][4] if row is not None else "")
        self.choose.set_sensitive(row is not None and not self.running and bool(model[row][5]))

    def choose_profile(self, _button):
        model, row = self.table.get_selection().get_selected()
        if row is not None and model[row][5]:
            self.owner.profiles.set_active_id(model[row][5])
            self.destroy()

    def close_requested(self, *_args):
        if self.running:
            self.cancel_requested()
        else:
            self.destroy()
        return True

    def cancel_requested(self, *_args):
        self.cancel.set()
        self.cancel_button.set_sensitive(False)
        self.progress.set_text("Завершаем текущую проверку и возвращаем настройки…")

    def start(self, _button, args):
        self.cancel.clear()
        self.running = self.owner.busy = True
        self.count = self.total = 0
        self.results.clear()
        self.owner.update_controls()
        self.choose.set_sensitive(False)
        self.cancel_button.set_sensitive(True)
        self.rtc.set_sensitive(False)
        for button in self.launch_buttons:
            button.set_sensitive(False)
        self.progress.set_fraction(0)
        self.progress.set_text("Ожидаем подтверждение администратора…")
        self.owner.with_agent(self.owner.submit, lambda: self.scan(args), self.finished)

    def scanning(self, profile):
        if not self.cancel.is_set():
            title = "Без Zapret" if profile == "BASELINE" else profile_label(profile)
            self.progress.set_text(f"{self.count + 1} / {self.total} · {title}")

    def add_result(self, profile, report):
        title = "Без Zapret" if profile == "BASELINE" else profile_label(profile)
        row = self.results.append((
            title, report.youtube, report.discord, report.summary,
            report.details, "" if profile == "BASELINE" else profile,
        ))
        if self.count == 0:
            self.table.get_selection().select_iter(row)
        self.count += 1
        self.progress.set_fraction(self.count / max(self.total, 1))

    def scan(self, args):
        probes = Probes()
        restored = False
        with TemporaryFile(mode="w+t", encoding="utf-8", errors="replace") as log:
            with subprocess.Popen(
                ADMIN + ["scan", *args], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=log, text=True, encoding="utf-8", errors="replace", bufsize=1,
            ) as process:
                try:
                    for line in process.stdout:
                        event, _, value = line.rstrip("\n").partition("\t")
                        if event == "TOTAL":
                            self.total = int(value)
                        elif event == "TRY":
                            GLib.idle_add(self.scanning, value)
                        elif event in ("CHECK", "FAILED"):
                            value, _, reason = value.partition("\t")
                            if not self.cancel.is_set():
                                report = (probes.check() if event == "CHECK" else Report(
                                    "—", "—", "Ошибка запуска",
                                    reason or "Не удалось запустить службу с этим профилем.",
                                ))
                                GLib.idle_add(self.add_result, value, report)
                            process.stdin.write("cancel\n" if self.cancel.is_set() else "next\n")
                            process.stdin.flush()
                        elif event == "RESTORED":
                            restored = True
                finally:
                    try:
                        process.stdin.close()
                    except BrokenPipeError:
                        pass
                rc = process.wait()
            log.seek(0)
            return rc, restored, log.read()[-6000:]

    def finished(self, future):
        self.running = self.owner.busy = False
        self.owner.update_controls()
        self.owner.refresh()
        self.cancel_button.set_sensitive(False)
        self.rtc.set_sensitive(True)
        for button in self.launch_buttons:
            button.set_sensitive(True)
        try:
            rc, restored, log = future.result()
        except (OSError, ValueError, RuntimeError) as exc:
            rc, restored, log = 1, False, str(exc)
        if rc == 0 and restored:
            message = ("Проверка остановлена" if self.cancel.is_set()
                       else f"Проверено профилей: {max(0, self.count - 1)}")
            self.progress.set_text(f"{message}. Настройки возвращены.")
        elif rc == 126:
            self.progress.set_text("Подтверждение отменено.")
        else:
            self.progress.set_text("Проверка прервана. Смотри подробности.")
        self.show_result(self.table.get_selection())
        if rc and log:
            self.detail.get_buffer().set_text(log)


