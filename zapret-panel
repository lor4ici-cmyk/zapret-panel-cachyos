    def card(self, parent):
        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.NONE)
        frame.get_style_context().add_class("panel")
        content = box()
        content.set_border_width(14)
        frame.add(content)
        parent.add(frame)
        return content

    def submit(self, work, done):
        future = self.executor.submit(work)
        future.add_done_callback(lambda finished: GLib.idle_add(done, finished))

    def refresh(self):
        if not (self.closed or self.busy or self.reading):
            self.reading = True
            self.submit(read_snapshot, self.show_snapshot)
        return not self.closed

    def show_snapshot(self, future):
        self.reading = False
        if self.closed or self.busy:
            return
        try:
            snapshot = future.result()
        except (OSError, RuntimeError, ValueError, KeyError) as error:
            self.snapshot = None
            self.status.set_text("Состояние недоступно")
            self.versions.set_text("Проверьте установку Zapret Panel.")
            self.message.set_text("Не удалось прочитать статус службы.")
            self.output = str(error)
            self.update_controls()
            return

        previous = self.snapshot
        selected = self.profiles.get_active_id()
        self.snapshot = snapshot
        self.status.set_text(STATUS.get(snapshot.service, "Состояние неизвестно"))
        style = self.status.get_style_context()
        for name in ("on", "off", "failed"):
            style.remove_class(name)
        style.add_class({"active": "on", "failed": "failed"}.get(snapshot.service, "off"))
        active_profile = profile_label(snapshot.strategy)
        self.applied.set_text(f"Применён: {active_profile}" if active_profile else "Профиль не применён")
        self.versions.set_text(snapshot.versions)
        if previous is None or previous.profiles != snapshot.profiles:
            self.profiles.remove_all()
            for profile in snapshot.profiles:
                self.profiles.append(profile, profile_label(profile))
        if previous is None or previous.strategy != snapshot.strategy:
            selected = snapshot.strategy or selected
        if selected not in snapshot.profiles:
            selected = snapshot.profiles[0] if snapshot.profiles else None
        if selected:
            self.profiles.set_active_id(selected)
        enabled = snapshot.autostart in {"enabled", "enabled-runtime"}
        self.autostart.handler_block_by_func(self.set_autostart)
        self.autostart.set_active(enabled)
        self.autostart.set_state(enabled)
        self.autostart.handler_unblock_by_func(self.set_autostart)
        if previous is None:
            self.message.set_text("Выберите профиль и нажмите «Включить»." if snapshot.profiles else "Профили не найдены.")
        self.update_controls()

    def update_controls(self):
        ready = self.snapshot is not None and not self.busy
        active = ready and self.snapshot.service == "active"
        selected = self.profiles.get_active_id()
        self.apply_button.set_label("Применить профиль" if active else "Включить")
        self.profiles.set_sensitive(ready)
        self.apply_button.set_sensitive(bool(ready and selected and (not active or selected != self.snapshot.strategy)))
        self.stop_button.set_sensitive(bool(ready and self.snapshot.service not in ("inactive", "")))
        self.autostart.set_sensitive(bool(ready and (self.snapshot.strategy or self.autostart.get_active())))
        self.scan_button.set_sensitive(bool(ready and selected))
        self.update_button.set_sensitive(ready)
        self.more.set_sensitive(ready)
        self.rollback.set_sensitive(bool(ready and self.snapshot.can_rollback))
        self.details.set_sensitive(bool(self.output))

    def apply_selected(self, _button):
        profile = self.profiles.get_active_id()
        if profile:
            self.execute(f"Применяем {profile_label(profile)}…", ADMIN + ["use", profile])

    def set_autostart(self, _switch, enabled):
        self.execute(
            "Настраиваем запуск с системой…",
            ADMIN + ["autostart-on" if enabled else "disable"],
        )
        return True

    def update_component(self, _item, action):
        self.execute("Выполняем обновление…" if action != "rollback" else "Возвращаем прошлые профили…", ADMIN + [action])

    def execute(self, message, args):
        if self.busy:
            return
        self.busy = True
        self.output = ""
        self.message.set_text(message)
        self.spinner.start()
        self.update_controls()
        self.with_agent(self.submit_action, args)

    def with_agent(self, callback, *args):
        if AGENT.is_file() and (self.agent is None or self.agent.poll() is not None):
            try:
                self.agent = subprocess.Popen([str(AGENT)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                pass
            else:
                # Give the fallback agent time to register with the session.
                GLib.timeout_add(450, callback, *args)
                return
        callback(*args)

    def submit_action(self, args):
        self.submit(lambda: run(args), self.finish_action)
        return False

    def finish_action(self, future):
        self.busy = False
        self.spinner.stop()
        try:
            result = future.result()
            self.output = result.stdout.strip()
            messages = {
                0: "Готово.",
                126: "Подтверждение отменено.",
                127: "Не удалось получить права администратора.",
            }
            self.message.set_text(messages.get(result.returncode, "Операция завершилась с ошибкой."))
        except OSError as error:
            self.output = str(error)
            self.message.set_text("Не удалось запустить команду.")
        self.update_controls()
        self.refresh()

    def show_details(self, _button):
        dialog = Gtk.Dialog(title="Подробности", transient_for=self, modal=True)
        dialog.add_button("Закрыть", Gtk.ResponseType.CLOSE)
        dialog.set_default_size(520, 330)
        view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True)
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        view.get_buffer().set_text(self.output)
        scroll = Gtk.ScrolledWindow()
        scroll.add(view)
        dialog.get_content_area().pack_start(scroll, True, True, 8)
        dialog.show_all()
        dialog.run()
        dialog.destroy()

    def close_window(self, *_):
        if self.busy:
            self.present()
        return self.busy

    def cleanup(self, *_):
        self.closed = True
        GLib.source_remove(self.timer)
        self.executor.shutdown(wait=False, cancel_futures=True)
        if self.agent is not None and self.agent.poll() is None:
            self.agent.terminate()


class Application(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        window = self.get_active_window()
        if window is None:
            Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
            provider = Gtk.CssProvider()
            provider.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )
            window = Panel(self)
        window.present()


if __name__ == "__main__":
    if os.geteuid() == 0:
        raise SystemExit("Откройте Zapret Panel от обычного пользователя.")
    GLib.set_prgname(APP_ID)
    raise SystemExit(Application().run())
